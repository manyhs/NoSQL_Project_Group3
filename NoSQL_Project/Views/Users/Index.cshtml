@* Author: Cristhel Mae Solomon *@
@model UserListViewModel
@{
    ViewData["Title"] = "User management";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="page-title mb-0">User management</h1>
    <a asp-action="Create" class="btn btn-nodesk">+ Add new user</a>
</div>

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-md">
        <input type="text" name="email" value="@Model.Email" class="form-control" placeholder="Filter by email" />
    </div>
    <div class="col-md-auto">
        <button type="submit" class="btn btn-nodesk">Filter</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
    </div>
</form>

@if (Model.Users.Count == 0)
{
    <div class="alert alert-light border">No users found.</div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover table-nodesk align-middle mb-0">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Email</th>
                        <th>First name</th>
                        <th>Last name</th>
                        <th>Type</th>
                        <th>Location</th>
                        <th># tickets</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < Model.Users.Count; i++)
                    {
                        var user = Model.Users[i];
                        <tr>
                            <td>@(i + 1)</td>
                            <td>@user.Email</td>
                            <td>@user.FirstName</td>
                            <td>@user.LastName</td>
                            <td>@user.UserType</td>
                            <td>@user.Location</td>
                            <td>@user.TicketCount</td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                                <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Delete this employee? Their tickets will stay.');">
                                    <input type="hidden" name="id" value="@user.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <p class="text-muted small mt-2">Showing @Model.Users.Count user(s).</p>
}
