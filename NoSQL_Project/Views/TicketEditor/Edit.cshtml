@* Author: Kavan Kamangar *@
@model TicketFormViewModel
@{
    ViewData["Title"] = "Edit ticket";
}
<div class="d-flex align-items-center gap-2 mb-3">
    <h1 class="page-title mb-0">Edit ticket</h1>
    <span class="badge @StatusBadge.CssClass(Model.Status)">@Model.Status</span>
    @if (Model.IsEscalated)
    {
        <span class="badge bg-danger">Escalated</span>
    }
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
                    <partial name="_TicketFields" />
                    <div class="d-flex justify-content-end gap-2">
                        <a asp-controller="Tickets" asp-action="Index" class="btn btn-outline-secondary">Back to list</a>
                        <button type="submit" class="btn btn-nodesk">Save changes</button>
                    </div>
                </form>
            </div>
        </div>

        <form asp-action="Delete" method="post" class="mt-3" onsubmit="return confirm('Delete this ticket? This cannot be undone.');">
            <input type="hidden" name="id" value="@Model.Id" />
            <button type="submit" class="btn btn-outline-danger btn-sm">Delete ticket</button>
            <span class="text-muted small ms-2">Normally a ticket is closed instead of deleted.</span>
        </form>
    </div>

    <div class="col-lg-5">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white fw-semibold">Status</div>
            <div class="card-body">
                @if (Model.HandledByName != null)
                {
                    <p class="small mb-3">
                        Last handled by <strong>@Model.HandledByName</strong>
                        on @(Model.HandledAt?.ToString("dd-MM-yyyy HH:mm")):<br />
                        <span class="text-muted">@Model.HandledByDescription</span>
                    </p>
                }
                else
                {
                    <p class="small text-muted mb-3">Nobody has picked up this ticket yet.</p>
                }

                <form asp-action="ChangeStatus" method="post">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="mb-2">
                        <label class="form-label small" for="status">New status</label>
                        <select id="status" name="status" class="form-select">
                            @foreach (var status in Enum.GetValues<TicketStatus>())
                            {
                                if (status == Model.Status)
                                {
                                    <option value="@status" selected>@status</option>
                                }
                                else
                                {
                                    <option value="@status">@status</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="mb-2">
                        <label class="form-label small" for="statusDescription">What was done</label>
                        <textarea id="statusDescription" name="description" rows="2" class="form-control"></textarea>
                    </div>
                    <button type="submit" class="btn btn-nodesk btn-sm">Update status</button>
                </form>
            </div>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white fw-semibold">Transfer ticket</div>
            <div class="card-body">
                <form asp-action="Transfer" method="post">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <label class="form-label small" for="newHandlerId">Give this ticket to another service desk employee</label>
                    <div class="d-flex gap-2">
                        <select id="newHandlerId" name="newHandlerId" class="form-select">
                            <option value="">Choose…</option>
                            @foreach (var option in Model.ServiceDeskOptions)
                            {
                                <option value="@option.Value">@option.Text</option>
                            }
                        </select>
                        <button type="submit" class="btn btn-outline-secondary">Transfer</button>
                    </div>
                </form>
            </div>
        </div>

        <partial name="_EscalationPanel" />
    </div>
</div>
