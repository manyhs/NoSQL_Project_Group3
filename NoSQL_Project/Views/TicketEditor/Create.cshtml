@* Author: Kavan Kamangar *@
@model TicketFormViewModel
@{
    ViewData["Title"] = "Create new incident ticket";
}
<h1 class="page-title mb-3">Create new incident ticket</h1>

<div class="card shadow-sm form-card">
    <div class="card-body p-4">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
            <partial name="_TicketFields" />
            <div class="d-flex justify-content-end gap-2">
                <a asp-controller="Tickets" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                <button type="submit" class="btn btn-nodesk">Submit ticket</button>
            </div>
        </form>
    </div>
</div>
