@* Author: Kavan Kamangar *@
@model TicketFormViewModel
<div class="row mb-3">
    <label asp-for="ReportedAt" class="col-sm-4 col-form-label">Date/time reported</label>
    <div class="col-sm-8">
        <input asp-for="ReportedAt" type="datetime-local" class="form-control" />
        <span asp-validation-for="ReportedAt" class="text-danger small"></span>
    </div>
</div>

<div class="row mb-3">
    <label asp-for="Subject" class="col-sm-4 col-form-label">Subject of incident</label>
    <div class="col-sm-8">
        <input asp-for="Subject" class="form-control" />
        <span asp-validation-for="Subject" class="text-danger small"></span>
    </div>
</div>

<div class="row mb-3">
    <label asp-for="Type" class="col-sm-4 col-form-label">Type of incident</label>
    <div class="col-sm-8">
        <select asp-for="Type" asp-items="Html.GetEnumSelectList<TicketType>()" class="form-select"></select>
    </div>
</div>

<div class="row mb-3">
    <label asp-for="EmployeeId" class="col-sm-4 col-form-label">Reported by user</label>
    <div class="col-sm-8">
        @if (User.IsServiceDesk())
        {
            <select asp-for="EmployeeId" asp-items="Model.EmployeeOptions" class="form-select">
                <option value="">Choose an employee…</option>
            </select>
        }
        else
        {
            <input type="text" class="form-control" value="@User.Identity!.Name" disabled />
        }
        <span asp-validation-for="EmployeeId" class="text-danger small"></span>
    </div>
</div>

<div class="row mb-3">
    <label asp-for="Priority" class="col-sm-4 col-form-label">Priority</label>
    <div class="col-sm-8">
        <select asp-for="Priority" asp-items="Html.GetEnumSelectList<TicketPriority>()" class="form-select"></select>
    </div>
</div>

<div class="row mb-3">
    @if (Model.Id == null)
    {
        <label asp-for="DeadlineDays" class="col-sm-4 col-form-label">Deadline/follow up</label>
        <div class="col-sm-8">
            <select asp-for="DeadlineDays" class="form-select">
                @foreach (var days in TicketFormViewModel.DeadlineChoices)
                {
                    <option value="@days">@days @(days == 1 ? "day" : "days")</option>
                }
            </select>
            <span asp-validation-for="DeadlineDays" class="text-danger small"></span>
        </div>
    }
    else
    {
        <label asp-for="Deadline" class="col-sm-4 col-form-label">Deadline/follow up</label>
        <div class="col-sm-8">
            <input asp-for="Deadline" type="datetime-local" class="form-control" />
            <span asp-validation-for="Deadline" class="text-danger small"></span>
        </div>
    }
</div>

<div class="row mb-3">
    <label asp-for="Description" class="col-sm-4 col-form-label">Description</label>
    <div class="col-sm-8">
        <textarea asp-for="Description" rows="6" class="form-control"></textarea>
        <span asp-validation-for="Description" class="text-danger small"></span>
    </div>
</div>
