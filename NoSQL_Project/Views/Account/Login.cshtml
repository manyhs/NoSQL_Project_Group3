@* Author: Mariana da Costa Reis *@
@model LoginViewModel
@{
    ViewData["Title"] = "Login";
}
<div class="card shadow-sm login-card mx-auto mt-4">
    <div class="card-body p-4">
        <h1 class="h4 text-center text-muted mb-1">NoDesk: TGG</h1>
        <p class="text-center text-muted mb-4">Please provide login credentials to login to NoDesk for The Garden Group</p>

        <form asp-action="Login" method="post">
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label">Username (email)</label>
                <input asp-for="Email" class="form-control" autofocus />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label">Password</label>
                <input asp-for="Password" class="form-control" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="form-check mb-3">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label">Remember me</label>
            </div>

            <button type="submit" class="btn btn-nodesk w-100">Login</button>
        </form>

        <details class="mt-3 small text-center">
            <summary class="link-nodesk">Forgot login details?</summary>
            <p class="text-muted mt-2 mb-0">Please contact the service desk. A service desk employee can set a new password for you.</p>
        </details>
    </div>
</div>
